# 이 저장소 코드가 읽는 환경 변수. KEY= 는 비밀(just secret-add KEY로 값 저장), KEY=값 은 비밀이 아닌 기본값
# 게이트 보고서 폴더. 기본값은 저장소 루트 기준 packages/gateway/reports (.gitignore에 있다)
CAUSTIC_REPORTS_DIR=packages/gateway/reports

# just verify(gate:all --changed)가 비교하는 기준 ref. CI는 PR의 base(origin/<base>)를 넣는다
GATE_BASE=main

# 게이트 자체 시험(pnpm gate:selftest)이 자식 실행에만 넣는 내부 플래그. 사람이 설정하지 않는다
# ws-check-ignore: CAUSTIC_SELFTEST

# scripts/guard.sh가 가드 안의 명령에만 넣는 표시(run, verify, browser, serve). scripts/shoot.mjs는 browser 슬롯 밖에서 돌지 않는다. 사람이 설정하지 않는다
# ws-check-ignore: WS_GUARD_ACTIVE

# caustic CLI가 읽을 catalog.json 경로. 기본은 설치된 @caustic/catalog의 dist/catalog.json이라 보통 비워 둔다(비밀 아님)
# ws-check-ignore: CAUSTIC_CATALOG
